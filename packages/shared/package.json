      "optional": true
    }
  },
  "devDependencies": {
    "@mr/eslint-config": "workspace:*",
    "@mr/tsconfig": "workspace:*",
    "@tanstack/react-start": "1.167.59",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "jsdom": "^29.0.2",
    "react": "19.2.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
