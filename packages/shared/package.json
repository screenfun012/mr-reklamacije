  },
  "devDependencies": {
    "@mr/eslint-config": "workspace:*",
    "@mr/tsconfig": "workspace:*",
    "@tanstack/react-start": "1.167.59",
    "@types/node": "^20.19.39",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
