{
  "name": "@mr/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./generate-config": {
      "types": "./dist/better-auth.generate.config.d.ts",
      "import": "./dist/better-auth.generate.config.js"
    }
  },
  "scripts": {
    "auth:generate": "npx auth@latest generate --config=./src/better-auth.generate.config.ts --adapter=drizzle --dialect=postgresql --yes --output=./.generated/better-auth.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.5",
    "@mr/db": "workspace:*",
    "@mr/shared": "workspace:*",
    "better-auth": "1.6.5",
    "drizzle-orm": "^0.45.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@mr/eslint-config": "workspace:*",
    "@mr/tsconfig": "workspace:*",
    "@types/node": "^20.19.39",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
