# Common (docs/11-deployment.md)
NODE_ENV=development
LOG_LEVEL=debug
TZ=Europe/Belgrade

# Server
PORT=3000
HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
PUBLIC_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Database (dev — never used by integration tests; see TEST_DATABASE_URL)
DATABASE_URL=postgresql://mr:mr_dev_password@localhost:5433/mr_reklamacije
# Integration tests only (must end with _test; assertIntegrationDatabase enforces this)
TEST_DATABASE_URL=postgresql://mr:mr_dev_password@localhost:5433/mr_reklamacije_test

# Auth (Better-Auth) — must be at least 32 chars in production
BETTER_AUTH_SECRET=dev-only-change-me-min-32-chars-long-secret-key
BETTER_AUTH_URL=http://localhost:3000

# Session idle timeouts (minutes)
SESSION_IDLE_ADMIN_MIN=30
SESSION_IDLE_OPERATOR_MIN=240
SESSION_IDLE_VIEWER_MIN=240
SESSION_IDLE_CLIENT_MIN=43200

# OpenAI (Phase 1+; optional in Phase 0)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS_PER_REQUEST=2000

# Uploads (local dev path; Railway volume mount in production)
UPLOAD_DIR=./data/uploads
