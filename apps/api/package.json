{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "depcruise": "dependency-cruiser --validate --config .dependency-cruiser.cjs --ts-config tsconfig.json --output-type err src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.14",
    "@opentelemetry/api": "1.9.1",
    "@mr/auth": "workspace:*",
    "@mr/db": "workspace:*",
    "@mr/logger": "workspace:*",
    "@mr/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.14",
    "jose": "6.2.3",
    "kysely": "^0.28.14",
    "pg": "^8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.4",
    "@mr/eslint-config": "workspace:*",
    "@mr/tsconfig": "workspace:*",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
