{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "depcruise": "dependency-cruiser --validate --config .dependency-cruiser.cjs --ts-config tsconfig.json --output-type err src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "recompress-attachments": "tsx --conditions=development scripts/recompress-attachments.ts",
    "import-legacy": "tsx --conditions=development scripts/import-legacy.ts",
    "link-employees-departments": "tsx --conditions=development scripts/link-employees-departments.ts",
    "migrate-attachments-to-s3": "tsx --conditions=development scripts/migrate-attachments-to-s3.ts",
    "check-attachment-integrity": "tsx --conditions=development scripts/check-attachment-integrity.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@fontsource-variable/figtree": "5.2.10",
    "@hono/node-server": "1.19.14",
    "@mr/auth": "workspace:*",
    "@mr/db": "workspace:*",
    "@mr/email": "workspace:*",
    "@mr/excel": "workspace:*",
    "@mr/i18n": "workspace:*",
    "@mr/logger": "workspace:*",
    "@mr/shared": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@turbodocx/html-to-docx": "^1.22.0",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.14",
    "ioredis": "^5.4.1",
    "jose": "6.2.3",
    "kysely": "^0.28.14",
    "pg": "^8.20.0",
    "playwright": "^1.61.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.2",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "@mr/eslint-config": "workspace:*",
    "@mr/tsconfig": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.6",
    "@types/sanitize-html": "^2.16.0",
    "aws-sdk-client-mock": "^4.1.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
