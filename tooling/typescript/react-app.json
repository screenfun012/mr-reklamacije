{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  }
}
