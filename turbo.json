{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@mr/i18n#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/paraglide/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@mr/auth#test:integration": {
      "dependsOn": ["@mr/db#test:integration", "^build"],
      "outputs": ["coverage/**"]
    },
    "api#test:integration": {
      "dependsOn": ["@mr/auth#test:integration", "^build"],
      "outputs": ["coverage/**"]
    },
    "@mr/i18n#test": {
      "dependsOn": ["build", "^build"],
      "outputs": ["coverage/**"]
    }
  }
}
