{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "@mr/i18n#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/paraglide/**"]
    },
    "@mr/eslint-config#build": {
      "outputs": []
    },
    "@mr/tsconfig#build": {
      "outputs": []
    },
    "@mr/tailwind-preset#build": {
      "outputs": []
    },
    "@mr/i18n#typecheck": {
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "@mr/auth#test:integration": {
      "cache": false,
      "dependsOn": ["@mr/db#test:integration", "^build"]
    },
    "api#test:integration": {
      "cache": false,
      "dependsOn": ["@mr/auth#test:integration", "^build"]
    },
    "@mr/i18n#test": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
