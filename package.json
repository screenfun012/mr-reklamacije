{
  "name": "mr-reklamacije",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "create-admin": "tsx scripts/create-admin-user.mts",
    "dev": "pnpm -r --filter \"./apps/*-web\" --parallel run dev",
    "dev:all": "tsx scripts/dev-all.mts",
    "dev:api": "tsx scripts/dev-api.mts",
    "audit:mr-duplicates": "tsx scripts/audit-mr-duplicates.mts",
    "cleanup:mr-duplicates-dev": "tsx scripts/cleanup-mr-duplicates-dev.mts",
    "dev:audit-deps": "tsx scripts/audit-phantom-deps.mts",
    "cleanup:junk": "tsx scripts/cleanup-workspace-junk.mts",
    "dev:check": "tsx scripts/dev-check.mts",
    "dev:db": "docker compose up -d postgres && (docker stop mr-reklamacije-api 2>/dev/null || true)",
    "format": "prettier --write .",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@mr/auth": "workspace:*",
    "@mr/db": "workspace:*",
    "@mr/shared": "workspace:*",
    "@mr/eslint-config": "workspace:*",
    "@types/node": "^24.13.3",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3",
    "youch": "4.1.1",
    "youch-core": "0.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,json,md}": "prettier --write"
  }
}
